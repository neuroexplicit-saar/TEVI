# Copy this file to configs/paths.env and set the paths. The scripts in experiments/ read it.

# MAD dataset folder, written by MAD/prepare.py (train.mmap, train.json, test.mmap, test.json)
MAD_DATA=/path/to/datasets/morphoMNIST_0

# Run tree: every script writes its model here, and the later steps read it from here.
RUN_ROOT=/path/to/runs/mad

# Optional: a separate, read-only run tree with the CLIP, its cached features and the SAEs.
# Default: RUN_ROOT.
# LOAD_ROOT=/path/to/other/runs/mad
